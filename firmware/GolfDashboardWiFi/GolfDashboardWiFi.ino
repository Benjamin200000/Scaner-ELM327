  uint32_t extraMask = 0; // Elegidos desde el movil; cero conserva prioridad original.
  Link link = Link::Connecting;
  uint32_t revision = 0;
  float rpmHz = 0;
  float speedHz = 0;
  float mafHz = 0;
  float lambdaHz = 0;
};

