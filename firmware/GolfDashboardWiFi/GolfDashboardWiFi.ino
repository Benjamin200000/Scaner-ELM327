  Support support = Support::Unknown;
};
struct Dashboard {
  Reading fields[FIELD_COUNT];
  uint8_t page = 0;
  uint8_t lambdaPid = 0; // Solo sensor 1: 0x24 (voltaje) o 0x34 (corriente).
